# --- Gemini (required) ---------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
AMNESIA_MODEL=gemini-3.5-flash

# --- Vertex AI instead of the Gemini API (optional) ----------------------
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Memory store --------------------------------------------------------
# Off by default: a local JSON file works with no cloud account at all.
AMNESIA_USE_FIRESTORE=false
AMNESIA_COLLECTION=amnesia_memory

# --- Optional: federate with an existing Personal Context Engine ---------
CONTEXT_ENGINE_URL=
CONTEXT_ENGINE_API_KEY=
